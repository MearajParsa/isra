# توسعهٔ محلی: این فایل را به .env.local کپی کنید (commit نمی‌شود؛ pnpm dev/start/migration خودکار می‌خوانند).
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=isra_mid
DB_PASSWORD=isra_mid_dev
DB_NAME=schema_mid
DB_MIGRATIONS_RUN=true

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SWAGGER_ENABLED=true

# اعتبارسنجی JWT با JWKS سرویس low (api-low باید بالا باشد؛ بدون hop در هر درخواست)
LOW_JWKS_URL=http://127.0.0.1:3001/c/.well-known/jwks.json
JWT_ISSUER=isra-low
JWT_AUDIENCE=isra

# secret جداگانهٔ هر جفت‌سرویس؛ مقدار هر جفت در دو سرویس باید یکسان باشد (در production ۳۲+ نویسهٔ تصادفی؛ مقدار نمونه رد می‌شود)
INTERNAL_SECRET_LOW=dev-pair-low-mid-0123456789abcdef0123
INTERNAL_SECRET_HIGH=dev-pair-mid-high-0123456789abcdef01
INTERNAL_URL_LOW=http://127.0.0.1:3001/c

# ۱.۷.۰ رسانهٔ گالری (docs-v2/31 §۴، قفل #16): مسیر مطلق **بیرون از پوشهٔ اپ** (مثل /home/<user>/isra-media)؛
# در production الزامی (نبود ⇒ بارگذاری/سرو فایل 503 و هشدار در boot). سهمیهٔ per جلسه به مگابایت (پیش‌فرض ۲۰۴۸).
MEDIA_DIR=
MEDIA_SESSION_QUOTA_MB=2048
# کلید HMAC نشانی‌های امضاشدهٔ محتوای رسانه (M-77)؛ ≥ ۳۲ بایت تصادفی، مستقل از high و secretهای internal.
# در production الزامی (fail-fast)؛ خالی در توسعه ⇒ کلید تصادفی per فرایند. ساخت: openssl rand -base64 48
MEDIA_URL_SECRET=
