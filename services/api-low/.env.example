# توسعهٔ محلی: این فایل را به .env.local کپی کنید (commit نمی‌شود؛ pnpm dev/start/migration خودکار می‌خوانند).
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=isra_low
DB_PASSWORD=isra_low_dev
DB_NAME=schema_low
DB_MIGRATIONS_RUN=true

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SWAGGER_ENABLED=true

# فقط توسعه: خالی ⇒ کلید RSA موقت (با ری‌استارت توکن‌ها باطل می‌شوند). production الزامی.
# JWT_PRIVATE_KEY_PEM=
OTP_PEPPER=dev-otp-pepper-dev-otp-pepper-1234
INTERNAL_SHARED_SECRET=dev-internal-secret-dev-internal-1234

# توسعه: OTP در کنسول (ترمینال api-low) چاپ می‌شود؛ پیامک واقعی نمی‌رود
SMS_PROVIDER=console
# production (Faraz): SMS_PROVIDER=faraz FARAZ_API_KEY=… FARAZ_SENDER=<line_number> FARAZ_PATTERN_CODE=<کد الگو> FARAZ_CODE_VAR=code

# وقتی api-mid بالا بود:
# INTERNAL_URL_MID=http://127.0.0.1:3002
