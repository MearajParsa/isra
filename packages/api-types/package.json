{
  "name": "@isra/api-types",
  "version": "1.0.0",
  "private": true,
  "description": "قرارداد API اسراء: schemaهای zod (منبع حقیقت)، نوع‌های TypeScript و OpenAPI 3.1 برای api-low/mid/high",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./openapi/*": "./openapi/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openapi",
    "CHANGELOG.md"
  ],
  "scripts": {
    "openapi": "tsx scripts/build-openapi.ts",
    "openapi:check": "tsx scripts/build-openapi.ts --check",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsup && tsc -p tsconfig.build.json && tsx scripts/build-openapi.ts --check",
    "openapi:breaking": "tsx scripts/breaking-changes.ts",
    "bundle": "tsup && tsc -p tsconfig.build.json",
    "prepare": "tsup && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts"
}
