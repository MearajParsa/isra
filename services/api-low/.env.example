# نمونهٔ توسعهٔ محلی (بدون Docker). مقدارهای واقعی/حساس را در .env.local (commit نمی‌شود) بگذارید.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=isra_low
DB_PASSWORD=change-me
DB_NAME=schema_low
DB_MIGRATIONS_RUN=true

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SWAGGER_ENABLED=true

# فقط توسعه: اگر خالی باشد کلید موقت ساخته می‌شود (production الزامی)
# JWT_PRIVATE_KEY_PEM=
OTP_PEPPER=change-me-change-me-change-me-change-me
INTERNAL_SHARED_SECRET=change-me-change-me-change-me-change-me

# توسعه: OTP در کنسول چاپ می‌شود (production ممنوع)
SMS_PROVIDER=console
