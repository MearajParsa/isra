# توسعهٔ محلی: این فایل را به .env.local کپی کنید (commit نمی‌شود؛ pnpm dev/start/migration خودکار می‌خوانند).
NODE_ENV=development
PORT=3003
LOG_LEVEL=info
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=isra_high
DB_PASSWORD=isra_high_dev
DB_NAME=schema_high
DB_MIGRATIONS_RUN=true

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SWAGGER_ENABLED=true

# اعتبارسنجی JWT با JWKS سرویس low (api-low باید بالا باشد؛ بدون hop در هر درخواست)
LOW_JWKS_URL=http://127.0.0.1:3001/c/.well-known/jwks.json
JWT_ISSUER=isra-low
JWT_AUDIENCE=isra

# secret جداگانهٔ هر جفت‌سرویس؛ مقدار هر جفت در دو سرویس باید یکسان باشد (در production ۳۲+ نویسهٔ تصادفی؛ مقدار نمونه رد می‌شود)
INTERNAL_SECRET_LOW=dev-pair-low-high-0123456789abcdef012
INTERNAL_SECRET_MID=dev-pair-mid-high-0123456789abcdef01
INTERNAL_URL_LOW=http://127.0.0.1:3001/c
INTERNAL_URL_MID=http://127.0.0.1:3002/o

# اولین توسعه‌دهندهٔ سیستم: وقتی این شماره در low ثبت‌نام/ورود کرد و هنوز developer وجود ندارد، خودکار developer می‌شود
# BOOTSTRAP_DEVELOPER_PHONE=09120000000

# ۱.۷.۰ (docs-v2/31 §۴): کلید HMAC URL امضاشدهٔ محتوای گالری (H-117)؛ ۳۲+ نویسهٔ تصادفی، جدا از mid و از secretهای internal.
# در production الزامی است؛ خالی در توسعه ⇒ کلید تصادفی per فرایند (مثلاً: openssl rand -base64 48)
MEDIA_URL_SECRET=
# مهلت بیکاری socket برای stream بارگذاری/محتوای گالری به/از mid (میلی‌ثانیه)
MEDIA_PROXY_TIMEOUT_MS=120000
